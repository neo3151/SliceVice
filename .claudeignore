# ==== Claude Ignore List ====
# Prevents Claude Code from reading massive directories
# and wasting context window tokens/quota.

# Virtual Environments & JS
.venv/
node_modules/

# Web Reader Assets
web/public/assets/
*.png
*.jpg
*.jpeg
*.webp
*.webm
*.svg
*.pdf
*.zip
*.psd
*.ai

# Compiled/Generated
exports/
SLICE_VICE_OMNIBUS_*.pdf

# IDE/Tools
.vscode/
.idea/
.agent/
.antigravity/
.claude/
